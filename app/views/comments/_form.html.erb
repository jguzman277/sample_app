<%# app/views/comments/_form.html.erb %>
<%= form_with(model: [post, comment], class: "space-y-4") do |form| %>
  <% if comment.errors.any? %>
    <div class="text-red-600">
      <h2 class="font-bold"><%= pluralize(comment.errors.count, "error") %> prohibited this comment from being saved:</h2>
      <ul class="list-disc list-inside">
        <% comment.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :body, "Your Comment", class: "block font-medium mb-1" %>
    <%= form.text_area :body, rows: 4, class: "w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.submit "Post Comment", class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
  </div>
<% end %>