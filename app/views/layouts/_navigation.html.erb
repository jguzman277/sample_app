<!--
  This is a responsive navigation bar using Tailwind CSS and a Stimulus controller.
  - The Stimulus controller toggles the 'hidden' class on the mobile menu.
  - The code includes both desktop and mobile layouts.
  - The Stimulus controller is defined in `app/javascript/controllers/navbar_controller.js`.
-->

<nav data-controller="navbar" class="bg-gray-800">
  <div class="max-w-7xl mx-auto px-2 sm:px-6 lg:px-8">
    <div class="relative flex items-center justify-between h-16">
      <!-- Mobile menu button -->
      <div class="absolute inset-y-0 left-0 flex items-center sm:hidden">
        <button type="button" data-action="navbar#toggle" class="inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-white hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-white" aria-controls="mobile-menu" aria-expanded="false">
          <span class="sr-only">Open main menu</span>
          <!-- Icon when menu is closed -->
          <svg class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Icon when menu is open -->
          <svg class="hidden h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Desktop links -->
      <div class="flex-1 flex items-center justify-center sm:items-stretch sm:justify-start">
        <div class="flex-shrink-0 flex items-center">
          <img class="block lg:hidden h-8 w-auto" src="https://i.fbcd.co/products/resized/resized-1500-1000/autism-treatments-f88c1ebbd6b1d4620a6b4585a540139387c19eb10d9e2d1ececdd4258a07e3e1.webp" alt="Workflow">
          <img class="hidden lg:block h-8 w-auto" src="https://i.fbcd.co/products/resized/resized-1500-1000/autism-treatments-f88c1ebbd6b1d4620a6b4585a540139387c19eb10d9e2d1ececdd4258a07e3e1.webp" alt="Workflow">
        </div>
        <div class="hidden sm:block sm:ml-6">
          <div class="flex space-x-4">
            <%= link_to "Home", root_path, class: "bg-gray-900 text-white px-3 py-2 rounded-md text-sm font-medium", aria: { current: "page" } %>
            <a href="#" class="text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium">Team</a>
            <%= link_to "Posts", posts_path, class: "text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
            <a href="#" class="text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium">Projects</a>
            <a href="#" class="text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium">Calendar</a>
          </div>
        </div>
      </div>

      <!-- Profile dropdown -->
        <%# --- START: NOTIFICATION DROPDOWN --- %>
        <% if user_signed_in? %>
        <div class="ml-3 relative" 
          data-controller="notifications" 
          data-notifications-unread-count-value="<%= current_user.unread_comment_notifications_count %>">
          <!-- Notification Bell Button -->
          <button 
            type="button" 
            data-action="click->notifications#toggle"
            class="relative bg-gray-800 p-1 rounded-full text-gray-400 hover:text-white focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-800 focus:ring-white">
            <span class="sr-only">View notifications</span>
            <!-- Bell Icon -->
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
            </svg>
            
            <!-- Badge for unread count -->
            <% if current_user.unread_comment_notifications_count > 0 %>
              <span data-notifications-target="badge" 
                    id="notifications_badge"
                    class="absolute top-0 right-0 inline-flex items-center justify-center px-2 py-1 text-xs font-bold leading-none text-white transform translate-x-1/2 -translate-y-1/2 bg-red-600 rounded-full">
                <%= current_user.unread_comment_notifications_count > 9 ? '9+' : current_user.unread_comment_notifications_count %>
              </span>
            <% else %>
              <span data-notifications-target="badge" id="notifications_badge" class="hidden"></span>
            <% end %>
          </button>

          <!-- Dropdown Menu -->
          <div 
            data-notifications-target="menu"
            class="hidden origin-top-right absolute right-0 mt-2 w-96 rounded-lg shadow-lg bg-white ring-1 ring-black ring-opacity-5 focus:outline-none z-40 max-h-96 overflow-hidden flex flex-col"
            role="menu">
            
            <!-- Header -->
            <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between bg-gray-50">
              <h3 class="text-sm font-semibold text-gray-900">Comment Notifications</h3>
              <div class="flex gap-2">
                <% if current_user.unread_comment_notifications.any? %>
                  <%= button_to mark_all_notifications_read_comments_path, 
                                method: :patch,
                                data: { turbo_stream: true },
                                class: "text-xs text-indigo-600 hover:text-indigo-800 font-medium" do %>
                    Mark all read
                  <% end %>
                <% end %>
                <% if current_user.unread_comment_notifications.any? %>
                  <%= button_to clear_all_notifications_comments_path, 
                                method: :delete,
                                data: { turbo_stream: true, turbo_confirm: "Clear all comment notifications?" },
                                class: "text-xs text-red-600 hover:text-red-800 font-medium" do %>
                    Clear all
                  <% end %>
                <% end %>
              </div>
            </div>

            <!-- Notifications List -->
            <div data-notifications-target="list" class="overflow-y-auto flex-1">
              <%= turbo_frame_tag "comment_notifications_list" do %>
                <%= render partial: 'comments/notifications_list', locals: { comments: current_user.all_comment_notifications.limit(10) } %>
              <% end %>
            </div>
          </div>
        </div>
        <% end %>
        <%# --- END: NOTIFICATION DROPDOWN --- %>

      <!-- Profile dropdown -->
      <div class="ml-3 relative" data-controller="dropdown">
        <div>
          <button 
            type="button" 
            data-action="click->dropdown#toggle" 
            class="max-w-xs bg-gray-800 rounded-full flex items-center text-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-800 focus:ring-white" 
            id="user-menu-button" 
            aria-expanded="false" 
            aria-haspopup="true">
            <span class="sr-only">Open user menu</span>
            <div class="h-8 w-8 rounded-full bg-indigo-600 flex items-center justify-center text-white font-semibold">
              <span>
                <% if user_signed_in? && current_user.first_name.present? && current_user.last_name.present? %>
                  <%= current_user.first_name.first.upcase %><%= current_user.last_name.first.upcase %>
                <% elsif user_signed_in? %>
                  <%= current_user.email.first(2).upcase %>
                <% else %>
                  G
                <% end %>
              </span>
            </div>
          </button>
        </div>

        <!-- Dropdown menu -->
        <div 
          data-dropdown-target="menu" 
          class="hidden origin-top-right absolute right-0 mt-2 w-48 rounded-md shadow-lg py-1 bg-white ring-1 ring-black ring-opacity-5 focus:outline-none z-50" 
          role="menu" 
          aria-orientation="vertical" 
          aria-labelledby="user-menu-button" 
          tabindex="-1">
          <% if user_signed_in? %>
            <%= link_to "Your Profile",
                        edit_user_registration_path,
                        data: { action: "click->dropdown#close" },
                        class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100",
                        role: "menuitem" %>
            <% if current_user.admin? %>
              <%= link_to "Admin Dashboard",
                          madmin_root_path,
                          data: { action: "click->dropdown#close" },
                          class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100",
                          role: "menuitem" %>
            <% end %>
            <%= link_to "Sign out",
                        destroy_user_session_path,
                        data: { turbo_method: :delete, action: "click->dropdown#close" },
                        class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100",
                        role: "menuitem" %>
          <% else %>
            <%= link_to "Sign In", 
                        new_user_session_path, 
                        data: { action: "click->dropdown#close" },
                        class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", 
                        role: "menuitem" %>
            <%= link_to "Sign Up", 
                        new_user_registration_path, 
                        data: { action: "click->dropdown#close" },
                        class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", 
                        role: "menuitem" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="sm:hidden hidden" id="mobile-menu" data-navbar-target="menu">
    <div class="px-2 pt-2 pb-3 space-y-1">
      <%= link_to "Home", root_path, class: "bg-gray-900 text-white block px-3 py-2 rounded-md text-base font-medium", aria: { current: "page" } %>
      <a href="#" class="text-gray-300 hover:bg-gray-700 hover:text-white block px-3 py-2 rounded-md text-base font-medium">Team</a>
      <%= link_to "Posts", posts_path, class: "text-gray-300 hover:bg-gray-700 hover:text-white block px-3 py-2 rounded-md text-base font-medium" %>
      <a href="#" class="text-gray-300 hover:bg-gray-700 hover:text-white block px-3 py-2 rounded-md text-base font-medium">Projects</a>
      <a href="#" class="text-gray-300 hover:bg-gray-700 hover:text-white block px-3 py-2 rounded-md text-base font-medium">Calendar</a>
    </div>
  </div>
</nav>
