<div class="flex items-center justify-center w-full min-h-screen">
  <div class="w-full max-w-xl p-12 space-y-6 rounded-lg shadow-xl">
    <h2 class="text-2xl font-bold text-center text-gray-900">Log In</h2>

    <%# Use simple_form_for instead of form_for %>
    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

      <%# The f.input helper generates the label, input, and wrapper divs %>
      <%= f.input :email,
                  required: false,
                  autofocus: true,
                  input_html: { autocomplete: "email" } %>

      <%= f.input :password,
                  required: false,
                  input_html: { autocomplete: "current-password" } %>

      <%# For checkboxes, use 'as: :boolean' %>
      <% if devise_mapping.rememberable? %>
        <%= f.input :remember_me, as: :boolean %>
      <% end %>

      <div class="pt-4">
        <%# Use f.button :submit for the submit tag %>
        <%= f.button :submit, "Log in", class: "flex justify-center w-full px-4 py-2 text-sm font-medium text-white bg-indigo-600 border border-transparent rounded-md shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer" %>
      </div>
    <% end %>

    <div class="text-center mt-4">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>