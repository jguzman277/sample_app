<div class="flex items-center justify-center w-full min-h-screen">
  <div class="w-full max-w-md p-12 space-y-6 rounded-lg shadow-xl bg-white">
    <h2 class="text-2xl font-bold text-center text-gray-900">Change your password</h2>

    <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= f.hidden_field :reset_password_token %>

      <div class="space-y-4">
        <%= f.input :password,
                    label: "New password",
                    autofocus: true,
                    hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length),
                    input_html: { autocomplete: "new-password" } %>
        <%= f.input :password_confirmation,
                    label: "Confirm new password",
                    input_html: { autocomplete: "new-password" } %>
      </div>

      <div class="actions pt-4">
        <%= f.button :submit, "Change my password", class: "flex justify-center w-full px-4 py-2 text-sm font-medium text-white bg-indigo-600 border border-transparent rounded-md shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer" %>
      </div>
    <% end %>

    <div class="pt-4">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>